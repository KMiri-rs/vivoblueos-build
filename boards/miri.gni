board_default_toolchain = "//build/toolchain:host"
default_linker_script = "//kernel/kernel/src/boards/qemu_riscv64/link.x"
qemu_exe = ""
qemu_machine = ""
if (host_os == "linux") {
  rust_abi_target = "x86_64-unknown-linux-gnu"
} else if (host_os == "mac") {
  rust_abi_target = "aarch64-apple-darwin"
}
qemu_extra_args = []
qemu_net_args = []
qemu_block_args = []

board_deps = []
